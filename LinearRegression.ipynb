import numpy as np
import matplotlib.pyplot as plt
from ipywidgets import interact, FloatSlider

# --- Dataset ---
X = np.array([1.5, 2.0, 2.2, 2.5, 3.0, 3.2, 3.5, 3.8, 4.0, 4.2,
              4.5, 4.8, 5.0, 5.2, 5.5, 5.8, 6.0, 6.2, 6.5, 7.0])
y = np.array([35, 33, 32, 31, 30, 29, 28, 27, 26, 25,
              24, 23, 22, 21, 20, 19, 18, 17, 16, 15])

# --- Loss functions ---
def compute_losses(w, b):
    y_pred = w * X + b
    errors = y - y_pred
    
    mse = np.mean(errors**2)
    rmse = np.sqrt(mse)
    l1 = np.mean(np.abs(errors))      # Mean Absolute Error
    l2 = np.sum(errors**2)            # Sum of Squared Errors
    
    return mse, rmse, l1, l2, y_pred, errors


def plot_line(w, b):
    mse, rmse, l1, l2, y_pred, errors = compute_losses(w, b)
    
    plt.figure(figsize=(9,6))
    
    # Plot true points
    plt.scatter(X, y, label="True Data", color="royalblue", s=80, edgecolor="white", zorder=3)
    
    # Plot regression line
    plt.plot(X, y_pred, label=f"y = {w:.2f}*x + {b:.2f}", color="crimson", linewidth=2.5, zorder=2)
    
    # Residual lines (vertical errors)
    for i in range(len(X)):
        plt.plot([X[i], X[i]], [y[i], y_pred[i]], color="gray", linestyle="--", linewidth=1)
    
    # Styling
    plt.xlabel("Car Weight (1000s of lbs)", fontsize=12, weight="bold")
    plt.ylabel("Miles Per Gallon", fontsize=12, weight="bold")
    plt.title("Fuel Efficiency Prediction (Interactive)", fontsize=14, weight="bold", pad=15)
    plt.legend(fontsize=11)
    plt.grid(True, linestyle=":", alpha=0.6)
    plt.gca().set_facecolor("#f9f9f9")
    plt.show()
    
    # Pretty print of losses
    print("Error Metrics:")
    print(f"    MSE   = {mse:.4f}")
    print(f"    RMSE  = {rmse:.4f}")
    print(f"    L1 Loss (MAE) = {l1:.4f}")
    print(f"    L2 Loss (SSE) = {l2:.4f}")

# --- Interactive sliders ---
interact(plot_line,
         w=FloatSlider(min=-10, max=10, step=0.1, value=-2.0, description="Slope (w)"),
         b=FloatSlider(min=-10, max=50, step=0.5, value=40.0, description="Intercept (b)"))
